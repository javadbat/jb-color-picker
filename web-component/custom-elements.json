{
  "schemaVersion": "1.0.0",
  "readme": "../README.md",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "lib/jb-color-picker.ts",
      "declarations": [
        {
          "kind": "class",
          "name": "JBColorPickerWebComponent",
          "description": "Standalone RGB and OKLCH color picker intended for composition inside color inputs.",
          "customElement": true,
          "tagName": "jb-color-picker",
          "superclass": { "name": "HTMLElement" },
          "attributes": [
            { "name": "color-space", "type": { "text": "'rgb' | 'oklch'" }, "description": "Locks the picker to one color space and hides the color-space switch." },
            { "name": "alpha-disabled", "type": { "text": "boolean" }, "default": "false", "description": "Hides alpha controls when present." },
            { "name": "disabled", "type": { "text": "boolean" }, "default": "false", "description": "Disables interaction." }
          ],
          "members": [
            { "kind": "field", "name": "value", "type": { "text": "string | JBColorPickerValue" }, "description": "Returns a CSS color string and accepts either a supported CSS color string or typed color object." },
            { "kind": "field", "name": "valueObject", "type": { "text": "JBColorPickerValue" }, "readonly": true, "description": "Current normalized typed RGB or OKLCH value." },
            { "kind": "field", "name": "valueAsString", "type": { "text": "string" }, "readonly": true, "description": "Alias of value." },
            { "kind": "field", "name": "colorSpace", "type": { "text": "'rgb' | 'oklch' | null" }, "description": "Configured color-space lock. Null allows user switching and displays the tabs." },
            { "kind": "field", "name": "alphaEnabled", "type": { "text": "boolean" }, "description": "Whether alpha controls are visible." },
            { "kind": "field", "name": "disabled", "type": { "text": "boolean" }, "description": "Whether interaction is disabled." }
          ],
          "events": [
            { "name": "input", "type": { "text": "CustomEvent<{ value: string; valueObject: JBColorPickerValue }>" }, "description": "Dispatched while the user changes the color." },
            { "name": "change", "type": { "text": "CustomEvent<{ value: string; valueObject: JBColorPickerValue }>" }, "description": "Dispatched when a user interaction is committed." },
            { "name": "load", "description": "Dispatched when the component connects." },
            { "name": "init", "description": "Dispatched after initial setup." }
          ],
          "cssParts": [
            { "name": "root" }, { "name": "space-switch" }, { "name": "space-button" },
            { "name": "color-surface" }, { "name": "surface-cursor" }, { "name": "hue-slider" },
            { "name": "alpha-slider" }, { "name": "fields" }, { "name": "field" },
            { "name": "result" }, { "name": "preview" }, { "name": "value-text" }
          ]
        }
      ]
    }
  ]
}
